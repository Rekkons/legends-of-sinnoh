.sn-book-th, .sn-book-td {
    flex-grow: 1;
    flex-basis: 0;
    padding: 3px 6px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--sn-line);
}
.sn-book-th {
    background-color: var(--sn-fill);
}
.sn-book-td-head {
    flex-direction: row;
    align-items: center;
}
.sn-book-td-icon {
    width: 34px;
    height: 34px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
.sn-book-card {
    margin: 9px 12px 0 0;
    padding: 6px 9px;
    border-width: 1px;
    border-color: var(--sn-line);
    flex-shrink: 0;
}
.sn-book-card-head {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}
.kit-root .sn-book-card-head > .sn-icon {
    margin-right: 6px;
}
.kit-root .sn-book-card-name {
    margin-right: 12px;
    flex-shrink: 1;
}
.sn-book-recipe {
    flex-direction: row;
    align-items: center;
}
.kit-root .sn-book-recipe > Label {
    margin-right: 6px;
}
.kit-root .sn-book-card-text {
    margin-top: 3px;
}
.sn-book-ability {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 3px;
}
.kit-root .sn-book-ability-blue, .kit-root .sn-book-ability-red {
    width: 240px;
    flex-shrink: 0;
    margin-right: 9px;
    white-space: normal;
    height: auto;
}
.kit-root .sn-book-ability-blue {
    color: var(--sn-ability-blue);
}
.kit-root .sn-book-ability-red {
    color: var(--sn-ability-red);
}
.kit-root .sn-book-ability > .sn-book-card-text {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-top: 0;
}
.sn-book-foot {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 9px;
    flex-shrink: 0;
}
.kit-root .sn-book-pos {
    margin: 0 18px;
}
.sn-book-side-panel {
    position: absolute;
    right: 9px;
    top: 110px;
    bottom: 237px;
    width: 645px;
}
.sn-book-chips {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 6px;
    flex-shrink: 0;
}
.kit-root .sn-book-chips-label {
    margin-right: 6px;
}
.sn-book-chip {
    margin-bottom: 3px;
}
.sn-book-fold {
    flex-direction: row;
    align-items: center;
    min-height: 33px;
    margin-top: 3px;
    padding: 0 9px 0 6px;
    border-width: 1px;
    border-color: var(--sn-line);
    background-color: var(--sn-book-paper);
    flex-shrink: 0;
}
.sn-book-fold:hover {
    background-color: var(--sn-fill);
}
.kit-root .sn-book-fold-name {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-right: 9px;
}
.sn-book-fold-open {
    padding: 3px 6px 9px 12px;
    border-width: 0 1px 1px 1px;
    border-color: var(--sn-line);
    background-color: var(--sn-book-paper);
    flex-shrink: 0;
}
.kit-root .sn-credits-notice {
    margin-bottom: 9px;
    flex-shrink: 0;
}
.sn-credits-tab {
    justify-content: space-between;
    min-height: 33px;
    margin-bottom: 3px;
}
.kit-root .sn-credits-tab-name {
    flex-shrink: 1;
    margin-right: 9px;
}
.kit-root {
    --sn-card-rim-c: #210d05;
    --sn-card-line-c: #290f08;
    --sn-card-soft-c: rgba(26, 10, 5, 0.7);
    --sn-card-ink: #252532;
    --sn-card-die-edge: #f49a9a;
    --sn-card-tag-up: #2f9e5a;
    --sn-card-tag-down: #d83848;
    --sn-card-tag-edge: #faf5f0;
}
.sn-card-stack {
    --sn-card-rim: var(--sn-card-rim-c);
    --sn-card-line: var(--sn-card-line-c);
    --sn-card-soft: var(--sn-card-soft-c);
    flex-shrink: 0;
}
.sn-card-out {
    filter: grayscale(100%);
    opacity: 0.85;
}
.sn-card-num {
    -unity-background-image-tint-color: var(--sn-card-ink);
}
.sn-card-num-max {
    opacity: 0.75;
}
.sn-card-tag {
    background-color: var(--sn-card-tag-up);
    border-color: var(--sn-card-tag-edge);
    justify-content: center;
    align-items: center;
}
.sn-card-tag-down {
    background-color: var(--sn-card-tag-down);
}
.sn-card-statpad {
    background-color: var(--sn-card-note-bg);
}
.sn-card-die {
    background-color: var(--sn-card-ink);
    border-color: var(--sn-card-die-edge);
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.sn-card-dot {
    width: 510px;
}
.sn-card-dotslim .sn-mon-tip-head {
    flex-direction: column;
    align-items: center;
}
.sn-card-dotslim .sn-mon-tip-info {
    margin-left: 0;
    align-self: stretch;
}
.sn-card-dotslim > .sn-mon-move, .sn-card-dotslim > .kit-muted {
    display: none;
}
.kit-root {
    --sn-card-tip-w: 432;
    --sn-card-wild-w: 432;
    --sn-card-zoom-w: 528;
    --sn-card-note-bg: #faf5f0;
    --sn-card-note-edge: #9a4b33;
}
.sn-card-tip {
    position: absolute;
    align-items: center;
}
.kit-root .sn-card-tip-rate {
    margin-top: 5px;
}
.sn-card-note {
    background-color: var(--sn-card-note-bg);
    border-color: var(--sn-card-note-edge);
    flex-shrink: 0;
}
.sn-card-note-head {
    flex-direction: row;
    align-items: center;
}
.kit-root .sn-card-note-ink {
    color: var(--sn-card-ink);
}
.sn-card-facts {
    margin-top: 6px;
    padding: 5px 9px;
    background-color: var(--sn-card-note-bg);
    border-width: 3px;
    border-radius: 6px;
    border-color: var(--sn-card-note-edge);
    flex-shrink: 0;
}
.kit-root .kit-btn.sn-card-close {
    margin: 0;
}
.sn-mon-zoom {
    position: absolute;
    left: 0;
    right: 0;
    top: 95px;
    bottom: 189px;
    align-items: center;
    justify-content: center;
}
.sn-card-zoomhead {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    margin-bottom: 6px;
}
.sn-card-evolve {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}
.kit-root .sn-card-evolve > * {
    margin-right: 6px;
    margin-bottom: 3px;
}
.kit-root {
    --sn-battle-sidename: #3868a8;
}
.sn-battle-entries {
    flex-direction: row;
    flex-shrink: 0;
}
.kit-root .sn-battle-entries > * {
    margin-left: 6px;
}
.sn-battle-entry-on {
    border-width: 3px;
    border-color: var(--sn-pick-strong);
}
.sn-battle-cols {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}
.sn-battle-infoside {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    align-items: center;
}
.sn-battle-infoside-foe {
    margin-left: 9px;
}
.sn-battle-sidehead {
    justify-content: center;
    flex-wrap: nowrap;
    margin-bottom: 3px;
    align-self: stretch;
}
.sn-battle-headside {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
}
.kit-root .sn-battle-headside > .sn-battle-headface {
    margin-right: 6px;
}
.kit-root .sn-battle-headside > .sn-battle-headface-end {
    margin-left: 6px;
    margin-right: 0;
}
.sn-battle-headface .sn-face-art {
    width: 30px;
    height: 30px;
}
.kit-root .sn-battle-sidehead > * {
    margin-right: 6px;
}
.kit-root .sn-battle-sidename {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    white-space: normal;
    height: auto;
    -unity-text-align: middle-center;
    color: var(--sn-battle-sidename);
}
.sn-battle-cards {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    align-self: stretch;
    align-items: center;
    overflow: hidden;
}
.sn-battle-card {
    flex-shrink: 0;
}
.sn-battle-swarmcards {
    flex-shrink: 0;
}
.sn-battle-swarmcard {
    position: absolute;
}
.sn-battle-infoside > .sn-battle-extra {
    justify-content: center;
    align-items: flex-start;
    align-content: flex-start;
    align-self: stretch;
    margin-top: 3px;
    margin-bottom: 0;
}
.sn-battle-swarmdots {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}
.kit-root .sn-battle-swarmdots > * {
    margin-right: 5px;
}
.sn-battle-cardtip {
    position: absolute;
    width: 560px;
    margin-left: 12px;
    padding: 14px;
}
.sn-battle-tiprow {
    margin-top: 6px;
}
.sn-battle-tiphead {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    border-width: 1px;
    border-color: var(--sn-line);
    background-color: var(--sn-fill);
}
.kit-root .sn-battle-tiphead > * {
    margin-right: 6px;
}
.kit-root .sn-battle-tiphead > .sn-icon {
    width: 24px;
    height: 24px;
}
.sn-battle-tipgap {
    flex-grow: 1;
}
.kit-root .sn-battle-tiptext {
    margin-top: 3px;
}
.sn-battle-entry {
    position: absolute;
    margin-left: 12px;
    padding: 14px;
}
.sn-battle-entry-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
    flex-shrink: 0;
}
.sn-battle-entry-cards {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
}
.sn-battle-entry-col {
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    margin-right: 6px;
    padding: 3px;
    border-width: 3px;
    border-radius: 9px;
    border-color: var(--sn-clear);
}
.sn-battle-entry-col.sn-battle-entry-now {
    border-color: var(--sn-pick-strong);
}
.kit-root .sn-battle-entry-tag {
    margin-top: 3px;
}
.sn-battle-entry-fit > .sn-battle-entry-cards {
    flex-grow: 0;
    flex-basis: auto;
}
.sn-battle-entry-fit .sn-battle-entry-col {
    justify-content: flex-start;
}
.kit-root {
    --sn-card-hole: #b0954a;
    --sn-pcard-hover: rgba(255, 240, 176, 0.3);
}
.kit-root .sn-pcard-panel {
    padding-bottom: 10px;
}
.sn-pcard-panel > .sn-party-head {
    margin-bottom: 3px;
}
.sn-card-holelook {
    background-color: var(--sn-card-hole);
    border-color: var(--sn-pick-strong);
}
.sn-pcard-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}
.sn-pcard-cols {
    flex-direction: row;
    flex-shrink: 0;
}
.sn-pcard-col {
    flex-shrink: 0;
    margin-right: 6px;
    justify-content: space-between;
}
.sn-pcard-top {
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}
.sn-pcard-off {
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: var(--sn-line);
    background-color: var(--sn-clear);
}
.sn-pcard-mon {
    flex-shrink: 0;
}
.sn-pcard-mon.sn-party-ok, .sn-pcard-mon.sn-party-picked {
    border-width: 0;
    margin: 0;
    background-color: var(--sn-clear);
}
.sn-pcard-ring {
    position: absolute;
    left: 0;
    top: 0;
    border-width: 5px;
    border-color: var(--sn-pick-strong);
    border-radius: 12px;
}
.sn-party-picked > .sn-pcard-ring {
    border-color: var(--sn-turn);
}
.sn-pcard-did {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 5px;
    border-radius: 12px;
}
.sn-pcard-hit {
    border-radius: 9px;
}
.sn-pcard-hit.sn-party-ok {
    border-width: 3px;
    border-color: var(--sn-pick-strong);
    background-color: var(--sn-clear);
}
.sn-pcard-hit.sn-party-picked {
    border-width: 5px;
    border-color: var(--sn-turn);
    background-color: var(--sn-clear);
}
.sn-pcard-hit.sn-party-press:hover, .sn-pcard-hit.sn-party-ok:hover {
    background-color: var(--sn-pcard-hover);
}
.sn-pcard-hit.sn-party-no {
    opacity: 1;
}
.sn-pcard-item {
    position: absolute;
    border-radius: 50%;
}
.sn-pcard-item.sn-party-ok {
    border-width: 5px;
    border-color: var(--sn-pick-strong);
    background-color: var(--sn-pcard-hover);
}
.sn-pcard-item.sn-party-picked {
    border-width: 5px;
    border-color: var(--sn-turn);
    background-color: var(--sn-pcard-hover);
}
.sn-pcard-item.sn-party-press:hover {
    background-color: var(--sn-pcard-hover);
}
.sn-pcard-foot {
    flex-shrink: 0;
    margin-top: 0;
}
.kit-root .sn-pcard-foot > * {
    margin-right: 4px;
}
.kit-root .sn-pcard-foot > .kit-btn {
    padding-left: 8px;
    padding-right: 8px;
}
.kit-root .sn-pcard-foot-tight > * {
    margin-right: 3px;
}
.kit-root .sn-pcard-foot-tight > .kit-btn {
    padding-left: 3px;
    padding-right: 3px;
}
.kit-root .sn-pcard-formicon .sn-card-pick-icon {
    margin-right: 0;
}
.sn-pcard-dot-hole {
    align-self: stretch;
    height: 42px;
    border-width: 3px;
    border-color: var(--sn-pick-strong);
    background-color: var(--sn-card-hole);
}
.sn-pcard-ghost {
    overflow: hidden;
    opacity: 0.8;
}
.sn-pcard-side {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}
.sn-pcard-side > .sn-party-box {
    margin-right: 0;
    margin-bottom: 6px;
    flex-basis: 0;
}
.sn-pcard-side > .sn-party-abil {
    flex-wrap: wrap;
    margin-top: 0;
    margin-bottom: 6px;
}
.sn-pcard-side > .sn-party-ask {
    flex-direction: column;
    align-items: stretch;
    margin-top: 0;
    margin-bottom: 6px;
    padding-top: 0;
    padding-bottom: 6px;
    border-top-width: 0;
    border-bottom-width: 1px;
}
.kit-root .sn-pcard-side .sn-party-ask-text {
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: 3px;
}
.sn-pcard-ask-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
}
.kit-root .sn-pcard-ask-row > * {
    margin-left: 9px;
    margin-top: 3px;
}
.sn-pcard-side .sn-party-pool {
    flex-direction: column;
}
.kit-root .sn-pcard-side .sn-party-poolcard {
    width: auto;
    margin-right: 0;
    margin-bottom: 6px;
    align-self: stretch;
}
