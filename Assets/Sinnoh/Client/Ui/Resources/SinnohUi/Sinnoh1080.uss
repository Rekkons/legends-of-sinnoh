/* 생성됨 — 손으로 고치지 않는다. 원본 Sinnoh.uss, 만드는 법 node Tools~/build-uss.mjs (키트 저장소). 1080 토큰 벌 */
.kit-root {
    --sn-logo: #ffffff;
    --sn-dex-field: #a49c4a;
    --sn-dex-field-lite: #d5d58b;
    --sn-dex-band: #101820;
    --sn-dex-plate: #ffffe6;
    --sn-dex-plate-edge: #525252;
    --sn-dex-pick: #ff6a73;
    --sn-dex-pic: #b4525a;
    --sn-dex-pic-edge: #730031;
    --sn-logo-sub: #f8d040;
    --sn-on-dark-muted: #a8b0c0;
    --sn-pick: #fff0b0;
    --sn-foot: #141c24;
    --sn-off: #707880;
    --sn-pick-strong: #f8d040;
    --sn-ability-blue: #5890d8;
    --sn-ability-red: #e05040;
    --sn-edge: #283038;
    --sn-card-back: #252532;
    --sn-time-day: #a8d8f0;
    --sn-time-evening: #f0a868;
    --sn-time-night: #283858;
    --sn-line: #c0c8d0;
    --sn-fill: #e8ecf0;
    --sn-turn: #f08a00;
    --sn-battle-scrim: rgba(16, 24, 32, 0.929);
    --sn-side-mine: #5890d8;
    --sn-side-foe: #e05040;
    --sn-ok: #78d088;
    --sn-side-none: #c0c8d0;
    --sn-clear: rgba(0, 0, 0, 0);
    --sn-roll-bg: #2c3848;
    --sn-flash: #ffffff;
    --sn-gloss: rgba(255, 255, 255, 0.5);
    --sn-ending-red: rgba(200, 24, 24, 0.45);
    --sn-ending-burn: #3a1408;
    --sn-ending-traitor: #ff4030;
    --sn-shard-0: #f090c0;
    --sn-shard-1: #f8d040;
    --sn-shard-2: #5890d8;
    --sn-fate-warp: #f070c8;
    --sn-fate-shadow: rgba(24, 8, 40, 0.72);
    --sn-fate-glitch: #58c8f8;
    --sn-result-red: #e03028;
    --sn-result-light: rgba(255, 248, 208, 0.85);
    --sn-result-band: rgba(248, 208, 64, 0.5);
    --sn-god-dialga: #3868c0;
    --sn-god-palkia: #c04898;
    --sn-god-giratina: #a83030;
    --sn-god-arceus: #a08030;
    --sn-orb: #7040b8;
    --sn-orb-edge: #f0e0ff;
    --sn-wipe-light: #fff8d0;
    --sn-ub-danger: #d83848;
    --sn-ub-last: rgba(216, 56, 72, 0.25);
    --sn-ub-edge: rgba(216, 56, 72, 0.8);
    --sn-ub-beam: rgba(240, 224, 255, 0.92);
    --sn-ub-wash: rgba(112, 64, 184, 0.5);
    --sn-ub-night: rgba(10, 8, 24, 0.82);
    --sn-ub-gold: #f8d040;
    --sn-ub-gold-wash: rgba(248, 208, 64, 0.45);
    --sn-tut-dim: rgba(16, 24, 32, 0.867);
    --sn-room-cover: rgba(16, 24, 32, 0.544);
    --sn-tut-band: rgba(16, 24, 32, 0.85);
    --sn-tut-fill: #ffffff;
    --sn-grade-weak: #a8c8f0;
    --sn-grade-moderate: #90d088;
    --sn-grade-strong: #f09050;
    --sn-grade-legendary: #f8d040;
    --sn-grade-alpha: #e05040;
    --sn-grade-ink: #283038;
    --sn-grade-alpha-ink: #ffffff;
    --sn-ink: #383838;
    --sn-types-weak: #a8e0a0;
    --sn-types-resist: #f0b4a8;
    --sn-types-immune: #404850;
    --sn-types-immune-ink: #ffffff;
}
.sn-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.kit-root .sn-off Label {
    color: var(--sn-off);
}
.sn-title-logo {
    position: absolute;
    left: 90px;
    top: 96px;
}
.sn-title-logo-sub {
    color: var(--sn-logo-sub);
}
.sn-title-logo-main {
    color: var(--sn-logo);
    scale: 2 2;
    transform-origin: left top;
}
.kit-root .sn-title-logo-main {
    margin-top: 6px;
    margin-bottom: 51px;
}
.sn-title-logo-en {
    color: var(--sn-on-dark-muted);
}
.sn-title-menu {
    position: absolute;
    left: 90px;
    top: 315px;
    width: 345px;
}
.sn-title-item {
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding: 0 6px;
}
.sn-title-item-two {
    height: 69px;
}
.sn-title-item-picked {
    background-color: var(--sn-pick);
}
.sn-title-cursor {
    width: 24px;
    visibility: hidden;
}
.kit-root .sn-title-cursor {
    margin-left: 0;
    margin-right: 9px;
}
.sn-title-item-picked .sn-title-cursor {
    visibility: visible;
}
.sn-title-desc {
    position: absolute;
    left: 90px;
    bottom: 66px;
    width: 630px;
}
.sn-notice {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}
.sn-notice-panel {
    width: 600px;
}
.kit-root .sn-notice-panel > * {
    margin-bottom: 12px;
}
.kit-root .sn-notice-line {
    margin-bottom: 3px;
}
.sn-title-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 36px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
    background-color: var(--sn-foot);
    color: var(--sn-on-dark-muted);
}
.sn-title-foot-right {
    flex-direction: row;
    align-items: center;
}
.kit-root .sn-title-version {
    margin-left: 18px;
}
.sn-title-update {
    position: absolute;
    right: 18px;
    bottom: 48px;
    flex-direction: row;
    align-items: center;
}
.kit-root .sn-title-update-text {
    margin-right: 15px;
}
.sn-title-update-wide {
    flex-direction: column;
    align-items: stretch;
    width: 450px;
}
.sn-title-update-row {
    flex-direction: row;
    align-items: center;
}
.kit-root .sn-title-update-amount {
    margin-left: auto;
}
.sn-title-update-bar {
    flex-grow: 1;
    height: 15px;
    margin-top: 6px;
    margin-right: 15px;
    border-width: 1px;
    border-color: var(--sn-edge);
    background-color: var(--sn-logo);
}
.sn-title-update-fill {
    height: 100%;
    width: 0;
    background-color: var(--sn-ability-blue);
}
.kit-root .sn-title-update-why {
    margin-top: 6px;
}
.sn-title-update-buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 9px;
}
.sn-title-update-buttons > * {
    margin-left: 9px;
}
.sn-head {
    color: var(--sn-logo);
}
.kit-root .sn-head {
    margin-bottom: 6px;
}
.sn-guide {
    color: var(--sn-on-dark-muted);
}
.kit-root .sn-guide {
    margin-bottom: 12px;
}
.sn-foot-row {
    flex-direction: row;
    margin-top: 15px;
}
.kit-root .sn-foot-row > * {
    margin-right: 9px;
}
.sn-picked {
    background-color: var(--sn-pick);
}
.sn-seat-chip {
    width: 15px;
    height: 15px;
    margin-right: 9px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--sn-edge);
}
.sn-mon {
    width: 128px;
    height: 128px;
    overflow: hidden;
    flex-shrink: 0;
}
.sn-mon-canvas {
    position: absolute;
    left: -32px;
    top: -16px;
    width: 96px;
    height: 96px;
    scale: 2 2;
    transform-origin: left top;
}
.sn-solo-col {
    position: absolute;
    left: 90px;
    top: 96px;
    width: 600px;
}
.sn-solo-row {
    flex-direction: row;
    align-items: center;
    height: 45px;
}
.sn-solo-label {
    width: 165px;
    flex-shrink: 0;
}
.sn-solo-opts {
    flex-direction: row;
    align-items: center;
}
.kit-root .sn-solo-note {
    margin-top: 9px;
    color: var(--sn-logo);
}
.sn-opt {
    height: 33px;
    padding: 0 12px;
    margin-right: 6px;
    justify-content: center;
    border-width: 1px;
    border-color: var(--sn-line);
    background-color: var(--sn-fill);
}
.sn-opt-picked {
    background-color: var(--sn-pick-strong);
    border-color: var(--sn-edge);
}
.sn-set-row {
    flex-direction: row;
    align-items: flex-start;
    padding-top: 6px;
}
.kit-root .sn-set-row > .sn-solo-label {
    margin-top: 8px;
}
.sn-set-opts {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 1;
}
.sn-set-opt {
    margin-bottom: 6px;
}
.kit-root .sn-set-val {
    margin-left: 12px;
}
.kit-root .sn-set-delete {
    margin-left: 12px;
}
.kit-root .sn-set-note > * {
    margin-top: 6px;
}
.sn-proto-opts {
    flex-direction: row;
    flex-wrap: wrap;
    width: 320px;
    flex-shrink: 0;
}
.sn-proto-opt {
    height: auto;
    padding: 3px;
    margin-bottom: 6px;
}
.sn-proto {
    width: 64px;
    height: 64px;
    overflow: hidden;
    flex-shrink: 0;
}
.sn-proto-canvas {
    position: absolute;
    left: 0;
    top: 0;
    scale: 2 2;
    transform-origin: left top;
}
.sn-setup-col {
    position: absolute;
    left: 90px;
    top: 60px;
    width: 480px;
}
.sn-setup-item {
    flex-direction: row;
    align-items: center;
    height: 39px;
    padding: 0 6px;
}
.sn-setup-item-peek {
    border-width: 3px;
    padding: 0 3px;
}
.kit-root .sn-setup-item-name {
    min-width: 144px;
    flex-shrink: 0;
    margin-right: 15px;
}
.sn-setup-detail {
    margin-top: 12px;
}
.sn-setup-hint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
}
.sn-village-map {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.sn-village-pin {
    position: absolute;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    margin-top: -9px;
    border-radius: 9px;
    border-width: 3px;
    border-color: var(--sn-edge);
}
.sn-village-pin-on {
    width: 30px;
    height: 30px;
    margin-left: -15px;
    margin-top: -15px;
    border-radius: 15px;
    border-width: 5px;
    border-color: var(--sn-pick-strong);
}
.sn-village-pin-name {
    position: absolute;
    left: 21px;
    top: -12px;
    padding: 1px 8px;
    background-color: var(--sn-tut-band);
    white-space: nowrap;
    display: none;
}
.kit-root .sn-village-pin-name {
    color: var(--sn-logo);
}
.sn-village-pin-on .sn-village-pin-name {
    display: flex;
    left: 30px;
    top: -6px;
}
.sn-setup-detail-body {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 9px;
}
.sn-village-art {
    width: 156px;
    height: 126px;
    margin-right: 12px;
    flex-shrink: 0;
}
.sn-mon-tile {
    align-items: center;
    margin-right: 6px;
}
.sn-setup-spec {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 3px;
}
.kit-root .sn-setup-spec > * {
    margin: 0 1px;
}
.sn-setup-spec-row {
    margin-top: 5px;
}
.sn-pick-col {
    position: absolute;
    left: 90px;
    top: 60px;
}
.sn-pick-area {
    flex-direction: row;
    align-items: stretch;
}
.sn-pick-panel {
    margin-right: 18px;
}
.sn-pick-tiles {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    margin-top: 9px;
}
.sn-pick-tile {
    width: 270px;
    padding: 9px;
    margin-right: 6px;
    align-items: center;
    overflow: hidden;
    border-width: 1px;
    border-color: var(--sn-line);
}
.sn-pick-tile.sn-picked {
    border-color: var(--sn-edge);
}
.sn-pick-clip {
    overflow: hidden;
}
.kit-root .sn-pick-name {
    margin-top: 6px;
}
.sn-pick-line {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}
.sn-pick-move {
    align-items: center;
    margin-top: 9px;
}
.kit-root .sn-pick-line > * {
    margin-right: 6px;
}
.sn-pick-tile .sn-mon {
    width: 192px;
    height: 192px;
}
.sn-pick-tile .sn-mon-canvas {
    left: 0;
    top: 0;
}
.sn-trainer-face {
    width: 160px;
    height: 160px;
    flex-shrink: 0;
}
.sn-trainer-art {
    width: 80px;
    height: 80px;
    scale: 2 2;
    transform-origin: left top;
}
.sn-ability-blue, .sn-ability-red {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--sn-edge);
}
.sn-ability-blue {
    background-color: var(--sn-ability-blue);
}
.sn-ability-red {
    background-color: var(--sn-ability-red);
}
.sn-pick-card {
    width: 375px;
}
.sn-pick-tile:hover {
    translate: 0 -5px;
    border-color: var(--sn-edge);
}
.sn-pick-ballbox {
    position: absolute;
    left: 0;
    right: 0;
    top: 9px;
    height: 192px;
    align-items: center;
    justify-content: center;
}
.sn-pick-ballstack {
    width: 128px;
    height: 128px;
    flex-shrink: 0;
}
.sn-pick-ballmove {
    position: absolute;
    left: 32px;
    top: 32px;
    width: 64px;
    height: 64px;
}
.sn-pick-ball {
    width: 16px;
    height: 16px;
    overflow: hidden;
    scale: 4 4;
    transform-origin: left top;
}
.sn-pick-ball-sheet {
    position: absolute;
    left: 0;
    top: 0;
    width: 144px;
    height: 16px;
}
.sn-pick-ball-open {
    position: absolute;
    left: 0;
    top: 0;
    width: 32px;
    height: 32px;
    scale: 4 4;
    transform-origin: left top;
}
.sn-pick-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--sn-flash);
}
.sn-pick-back {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--sn-card-back);
    -unity-slice-left: 47;
    -unity-slice-right: 47;
    -unity-slice-top: 47;
    -unity-slice-bottom: 47;
    -unity-slice-scale: 1px;
}
.sn-pick-back-in {
    width: 144px;
    height: 144px;
    flex-shrink: 0;
}
.sn-pick-gloss {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 40%;
    background-color: var(--sn-gloss);
}
.sn-setup-drop {
    position: absolute;
    left: 90px;
    top: 60px;
    flex-direction: row;
    align-items: center;
}
.kit-root .sn-setup-drop-name {
    margin-left: 12px;
}
.kit-root .sn-setup-drop-village {
    margin-left: 12px;
    margin-right: 6px;
}
.sn-pick-ability {
    align-self: stretch;
    margin-top: 6px;
}
.kit-root .sn-pick-ability-text {
    margin-top: 3px;
}
.sn-hud-top {
    position: absolute;
    left: 6px;
    top: 6px;
    right: 6px;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
}
.sn-hud-seats {
    flex-direction: row;
    flex-shrink: 1;
    min-width: 0;
}
.sn-hud-seat {
    flex-direction: row;
    align-items: center;
    margin-right: 2px;
    padding: 4px;
    flex-shrink: 1;
    min-width: 0;
}
.kit-root .sn-hud-seat-name {
    margin-left: 4px;
    margin-right: 2px;
}
.kit-root .sn-hud-seats .sn-hud-seat-name {
    width: 144px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}
.sn-hud-seat-turn .sn-face {
    border-color: var(--sn-turn);
}
.sn-face {
    flex-shrink: 0;
    border-width: 2px;
    border-color: var(--sn-edge);
}
.sn-face-in {
    flex-shrink: 0;
    flex-direction: row;
    border-width: 2px;
    border-color: var(--sn-edge);
    background-color: var(--sn-fill);
}
.sn-face-art {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
}
.sn-face-big .sn-face-art {
    width: 90px;
    height: 90px;
}
.sn-face-seat {
    flex-shrink: 0;
    align-self: stretch;
}
.kit-root .sn-face-seat {
    height: auto;
    padding: 0 0 0 2px;
    -unity-text-align: middle-center;
}
.sn-owner {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}
.kit-root .sn-owner > .sn-face {
    margin-right: 8px;
}
.sn-shrine-head .sn-owner {
    flex-shrink: 1;
}
.kit-root .sn-shrine-head .sn-owner > Label {
    flex-shrink: 1;
    white-space: normal;
    height: auto;
}
.kit-root .sn-owner > .sn-guide {
    flex-shrink: 1;
    white-space: normal;
    height: auto;
}
.sn-face-tag .sn-face-art {
    width: 30px;
    height: 30px;
}
.sn-hud-status {
    flex-direction: row;
    align-items: center;
    padding: 7px;
    flex-shrink: 0;
}
.kit-root .sn-hud-status > * {
    margin-left: 6px;
}
.kit-root .sn-hud-status .kit-badge {
    height: 33px;
}
.kit-root .sn-hud-status #board-hud-turn {
    max-width: 160px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}
.kit-root .sn-hud-many .sn-hud-status #board-hud-turn {
    display: none;
}
.kit-root.sn-lang-en .sn-hud-many .sn-hud-status #board-hud-turn {
    display: none;
}
.sn-hud-tools {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}
.kit-root .sn-hud-status > .sn-hud-tools {
    margin-left: 0;
}
.kit-root .sn-hud-tools > * {
    margin-left: 6px;
}
.kit-root .sn-hud-tools-down .sn-hud-status {
    align-items: flex-start;
    padding: 4px;
    padding-bottom: 39px;
}
.kit-root .sn-hud-tools-down .sn-hud-tools {
    position: absolute;
    left: 4px;
    bottom: 4px;
}
.kit-root .sn-hud-many #board-hud-discards {
    display: flex;
}
.kit-root #board-hud-log-discards {
    display: none;
}
.kit-root .sn-hud-many #board-hud-log-discards {
    display: none;
}
.kit-root .sn-hud-time-day {
    background-color: var(--sn-time-day);
}
.kit-root .sn-hud-time-evening {
    background-color: var(--sn-time-evening);
}
.kit-root .sn-hud-time-night {
    background-color: var(--sn-time-night);
    color: var(--sn-logo);
}
.sn-hud-dock {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 6px;
    height: 177px;
    flex-direction: row;
}
.kit-root .sn-hud-dock {
    padding-top: 20px;
}
.kit-root .kit-tip {
    --kit-tip-gap: 12;
}
.sn-hud-dock-tall {
    height: 222px;
}
.sn-hud-res {
    position: absolute;
    left: 0;
    bottom: 100%;
    margin-bottom: 3px;
    flex-direction: row;
    align-items: center;
    padding: 9px;
}
.sn-hud-res-item {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 9px;
}
.kit-root .sn-hud-res-item > Label {
    margin-left: 3px;
}
.kit-root .sn-hud-res-jp {
    flex-shrink: 0;
    margin-left: 3px;
    margin-right: 12px;
    padding: 0 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: var(--sn-line);
}
.sn-hud-res-zero {
    opacity: 0.4;
}
.sn-hud-res-off {
    visibility: hidden;
}
.sn-hud-rotate {
    position: absolute;
    right: 0;
    bottom: 100%;
    margin-bottom: 3px;
    flex-direction: row;
    align-items: flex-end;
}
.kit-root .sn-hud-rotate > * {
